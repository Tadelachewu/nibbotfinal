# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*

# firebase
firebase-debug.log
firestore-debug.log

# uploaded files (served via route handler, not static)
/public/uploads/
/storage/uploads/

# reranker-service (Python) — venv/cache are large, machine-local, and
# reproducible from requirements.txt; never commit them
reranker-service/.venv/
reranker-service/__pycache__/
reranker-service/**/__pycache__/
*.pyc