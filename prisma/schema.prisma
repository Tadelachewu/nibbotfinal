generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums used across models
enum ResponseType {
  static
  api
  report
}

enum ReportStatus {
  pending
  reviewed
  resolved
}

enum ReportPriority {
  low
  medium
  high
  urgent
}

enum KYCFieldType {
  text
  number
  tel
  email
  password
  boolean
}

enum LogStatus {
  success
  failed
  error
}

enum MenuApprovalStatus {
  pending
  approved
  rejected
}

enum AdminRole {
  admin
  checker
  support
}

// Menu items (admin-created navigation/content entries)
model MenuItem {
  id                String        @id
  parentId          String?
  parent            MenuItem?     @relation("MenuToChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children          MenuItem[]    @relation("MenuToChildren")
  name              String
  nameAm            String?
  responseType      ResponseType
  content           String?       @db.Text
  contentAm         String?       @db.Text
  apiConfig         Json?         @map("api_config")
  supportAssignee   String?       @map("support_assignee")
  order             Int            @default(0)
  isActive          Boolean        @default(true)
  approvalStatus    MenuApprovalStatus @default(approved)
  createdBy         String?
  reviewedBy        String?
  reviewedAt        DateTime?
  rejectionReason   String?       @db.Text
  pendingUpdate     Json?         @map("pending_update")
  pendingStatus     MenuApprovalStatus? @map("pending_status")
  pendingCreatedBy  String?       @map("pending_created_by")
  pendingReviewedBy String?       @map("pending_reviewed_by")
  pendingReviewedAt DateTime?     @map("pending_reviewed_at")
  pendingRejectionReason String?  @db.Text @map("pending_rejection_reason")
  trackClicks       Boolean        @default(false)
  clickCount        Int            @default(0)
  sessionClickCount Int            @default(0)
  translations      Json?
  attachmentDescription String? @map("attachment_description")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  kbEnabled         Boolean        @default(true)  @map("kb_enabled")

  // relations
  attachments       MenuAttachment[] @relation("MenuAttachment_menu")
  attachedTo        MenuAttachment[] @relation("MenuAttachment_attached")
  kycMappings       MenuKYC[]        @relation("MenuKYC_menu")
  reports           UserReport[]     @relation("Menu_reports")
  clicks            ClickHistory[]   @relation("Menu_clicks")
  kbChunks          KBChunk[]        @relation("KBChunk_menu")

  @@map("menu_items")
}

// Many-to-many helper linking a menu to other attached menus
model MenuAttachment {
  id             Int      @id @default(autoincrement())
  menuId         String
  attachedMenuId String

  menu           MenuItem @relation("MenuAttachment_menu", fields: [menuId], references: [id], onDelete: Cascade)
  attachedMenu   MenuItem @relation("MenuAttachment_attached", fields: [attachedMenuId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@unique([menuId, attachedMenuId])
  @@map("menu_attachments")
}

// KYC fields used in conversational forms
model KYCField {
  id         String      @id
  name       String
  prompt     String
  promptAm   String?
  type       KYCFieldType
  validation String?
  order      Int          @default(0)
  required   Boolean      @default(false)
  showToUser Boolean      @default(false) @map("show_to_user")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // inverse relation to menus that use this KYC item
  menuMappings MenuKYC[] @relation("MenuKYC_kyc")

  @@map("kyc_fields")
}

// Join table to attach KYC fields to a particular Menu (form)
model MenuKYC {
  id      Int      @id @default(autoincrement())
  menuId  String
  kycId   String
  // per-menu ordering of the KYC field
  order   Int      @default(0)

  menu    MenuItem @relation("MenuKYC_menu", fields: [menuId], references: [id], onDelete: Cascade)
  kyc     KYCField @relation("MenuKYC_kyc", fields: [kycId], references: [id], onDelete: Cascade)

  @@unique([menuId, kycId])
  @@map("menu_kyc")
}

// Reports submitted by end users via the conversational forms
model UserReport {
  id            String         @id
  userId        String?
  menuId        String?
  menuName      String
  data          Json
  status        ReportStatus   @default(pending)
  priority      ReportPriority @default(medium)
  adminResponse String?        @db.Text
  internalNotes String?        @db.Text
  supportAssignee String?      @map("support_assignee")
  serviceRating Int?           @map("service_rating")
  serviceFeedback String?      @db.Text @map("service_feedback")
  serviceRatedAt DateTime?     @map("service_rated_at")
  serviceRatedBySessionId String? @map("service_rated_by_session_id")
  serviceRatedSupportAssignee String? @map("service_rated_support_assignee")
  resolvedBy    String?        @map("resolved_by")
  resolvedAt    DateTime?      @map("resolved_at")
  // timestamp and creation
  timestamp     DateTime       @default(now())
  createdAt     DateTime       @default(now())

  // relations
  menu          MenuItem?        @relation("Menu_reports", fields: [menuId], references: [id], onDelete: Cascade)
  activities    ReportActivity[] @relation("ReportToActivities")

  @@index([menuId])
  @@index([userId])
  @@index([supportAssignee])
  @@index([serviceRatedSupportAssignee])
  @@map("user_reports")
}

model ReportActivity {
  id        Int      @id @default(autoincrement())
  reportId  String
  type      String   // 'creation', 'assignment', 'response', 'resolution', 'escalation'
  actor     String
  target    String?
  content   String?  @db.Text
  timestamp DateTime @default(now())

  // relation
  report    UserReport @relation("ReportToActivities", fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_activities")
}

// Application-level settings (singleton row expected)
model AppSettings {
  id                 Int      @id @default(1)
  supportedLanguages Json?
  systemTranslations Json?
  reportIdId         Int?     @unique
  reportId           ReportIdConfig? @relation(fields: [reportIdId], references: [id], onDelete: SetNull)
  botAvatarType      String   @default("text")
  botAvatarText      String?
  botAvatarImage     String?  @db.Text
  userAvatarType     String   @default("text")
  userAvatarText     String?
  userAvatarImage    String?  @db.Text
  appLogo            String?  @db.Text
  showAdminPanelIcon Boolean  @default(true)
  liveAgentEnabled   Boolean  @default(true)
  liveAgentBubbleEnabled Boolean @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("app_settings")
}

model ReportIdConfig {
  id            Int    @id @default(autoincrement())
  prefix        String @default("NIB")
  yearEnabled   Boolean @default(true)
  numberLength  Int    @default(6)
  startValue    Int    @default(100000)
  resetEveryYear Boolean @default(true)

  settings      AppSettings[]
  @@map("report_id_config")
}

// Click/session history for menus (used to calculate unique sessionClickCount)
model ClickHistory {
  id        Int      @id @default(autoincrement())
  menuId    String
  sessionId String
  clickedAt DateTime @default(now())

  menu      MenuItem @relation("Menu_clicks", fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
  @@map("click_history")
}

// Interaction logs (chat exchanges) - stored as JSON/text
model InteractionLog {
  id           Int       @id @default(autoincrement())
  timestamp    DateTime  @default(now())
  sessionId    String
  userMessage  String    @db.Text
  botResponse  String    @db.Text
  status       LogStatus
  endpoint     String?
  responseTime Int?
  errorDetails String?
  tags         String[]

  @@map("interaction_logs")
}

// Admin credentials if managed server-side (stored hashed)
model AdminCredential {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique

  passwordHash String
  role         AdminRole @default(admin)
  groupName    String?  @map("group_name")
  sessionVersion Int      @default(1) @map("session_version")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  passwordExpiresAt DateTime? @map("password_expires_at")
  createdAt    DateTime @default(now())

  @@index([groupName])
  @@map("admin_credentials")
}

// Admin recovery tokens for password reset (persisted for production)
model AdminRecoveryToken {
  token     String   @id
  username  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([username])
  @@map("admin_recovery_tokens")
}

// Centralized Audit Log for administrative and sensitive actions
model AuditLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  actor     String   // username of the admin performing the action
  action    String   // e.g., "CREATE_USER", "UPDATE_SETTINGS", "DELETE_MENU"
  target    String   // e.g., "user:jdoe", "settings:global", "menu:123"
  details   String?  @db.Text // JSON string of changes or additional context
  ip        String?
  userAgent String?

  @@index([actor])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

// KB chunks — text fragments from menus OR articles, for vector search.
// The article unique index is managed via raw SQL — Prisma does not support
// partial unique indexes. The `embedding` column IS declared below via
// Unsupported() — do not remove it. Without it, `prisma migrate dev` diffs
// the DB against this schema, sees a column it doesn't know about, and
// proposes DROP COLUMN "embedding" — which is exactly what silently broke
// KB search once already (see migration 20260702131115_kb).
model KBChunk {
  id         Int       @id @default(autoincrement())
  menuId     String?   // null for article-sourced chunks
  articleId  String?   // null for menu-sourced chunks
  chunkIndex Int       @default(0)
  text       String    @db.Text
  lang       String    @default("en")
  tokenCount Int?
  indexedAt  DateTime  @default(now())
  embedding  Unsupported("vector(1024)")?

  menu    MenuItem?  @relation("KBChunk_menu",    fields: [menuId],    references: [id], onDelete: Cascade)
  article KBArticle? @relation("KBChunk_article", fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([menuId, chunkIndex, lang])
  // Article unique index: kb_chunks_articleId_chunkIndex_lang_key (partial, applied via raw SQL)
  @@index([menuId])
  @@index([articleId])
  @@map("kb_chunks")
}

// Admin-authored knowledge articles — indexed into KB alongside menus.
// Multi-language the same way MenuItem is: title/body is English (default),
// titleAm/bodyAm is Amharic, translations covers any other configured
// language. One article = one topic, all its languages together — not one
// row per language. Per-chunk language is still tracked on KBChunk.lang.
model KBArticle {
  id           String    @id @default(cuid())
  title        String
  body         String    @default("") @db.Text
  titleAm      String?
  bodyAm       String?   @db.Text
  translations Json?
  enabled      Boolean   @default(true)
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  chunks       KBChunk[] @relation("KBChunk_article")

  @@map("kb_articles")
}

// Singleton configuration row (id always = 1)
model KBConfig {
  id              Int      @id @default(1)
  enabled         Boolean  @default(true)
  embeddingModel  String   @default("bge-m3")   @map("embedding_model")
  generationModel String   @default("aya:8b")   @map("generation_model")
  // 'ollama' (default) or 'openrouter'. Only affects the main chat answer
  // generation step (queryKB's final answer + follow-up question rewriting)
  // — embeddings always go through Ollama, and the AI Evaluation judge is
  // intentionally kept on Ollama regardless of this setting (see
  // src/lib/eval/judge.ts's own provider factory).
  generationProvider String @default("ollama")  @map("generation_provider")
  // Model id used only when generationProvider = 'openrouter', e.g.
  // "nvidia/nemotron-3-ultra-550b-a55b:free". Kept separate from
  // generationModel so flipping providers back and forth never clobbers the
  // other provider's model choice. The API key itself lives in
  // OPENROUTER_API_KEY (.env) — never stored here, never returned by
  // GET /api/admin/kb/config.
  openrouterModel String?  @map("openrouter_model")
  chunkSize       Int      @default(350)         @map("chunk_size")
  chunkOverlap    Int      @default(60)          @map("chunk_overlap")
  // Defaults tuned against real content: section-aware chunking means a
  // single page can produce 10+ sibling chunks, so topK=5 routinely excluded
  // the correct one. 0.72 rejected genuinely correct matches on bge-m3's
  // typical similarity range for short/listy content (observed ~0.4-0.55
  // for verified-correct chunks).
  topK            Int      @default(10)          @map("top_k")
  minScore        Float    @default(0.5)         @map("min_score")
  temperature     Float    @default(0.2)         @map("temperature")
  rerankerEnabled Boolean  @default(false)        @map("reranker_enabled")
  rerankerModel   String?  @default("bge-reranker-base") @map("reranker_model")
  rerankPoolSize  Int      @default(15)           @map("rerank_pool_size")
  // Cross-encoder relevance-probability threshold, applied instead of
  // minScore when rerankerEnabled — different score distribution (sigmoid
  // over a cross-encoder logit, not cosine similarity) so it needs its own knob.
  // 0.25 not 0.62: every chunk is prefixed with its page name/heading for
  // lexical/vector grounding (see KBChunk indexing), which bge-reranker-base
  // reads as label noise and scores markedly lower even for correct matches —
  // measured ~0.37 for a verified-correct match vs. <0.01 for wrong ones, so
  // 0.25 keeps a wide margin above real answers while still well above noise.
  rerankMinScore  Float    @default(0.25)         @map("rerank_min_score")
  systemPrompt    String?  @db.Text              @map("system_prompt")
  updatedAt       DateTime @updatedAt

  @@map("kb_config")
}

// Query audit log for the KB "Ask AI" flow — written via raw SQL in kb.ts
// (fire-and-forget inserts), but modeled here so `prisma migrate dev` knows
// this table exists and never proposes dropping it (see the KBChunk.embedding
// comment above for why that matters — it already happened once).
model KBQueryLog {
  id            Int      @id @default(autoincrement())
  sessionId     String
  question      String   @db.Text
  answer        String?  @db.Text
  noAnswer      Boolean
  confidence    String?
  // @default([]) is load-bearing, not cosmetic: kb.ts's INSERTs for the
  // "no answer" path omit this column entirely, relying on the DB default to
  // fill it in. It was previously only set via raw migration SQL (never
  // declared here) — any schema reconciliation that trusts schema.prisma as
  // the source of truth (e.g. `prisma db push`) silently stripped it back to
  // no-default, which reintroduced a NOT NULL violation on every "no answer"
  // log write. Declaring it here is what makes the fix actually durable.
  sourceMenuIds String[] @default([])
  lang          String
  durationMs    Int?
  // -------- Per-stage timing breakdown (all ms, nullable when a stage is
  // skipped or never reached) — so the admin Query Audit Log can surface
  // which part of the pipeline is making responses slow.
  rewriteMs     Int? // follow-up question rewrite
  normalizeMs   Int? // typo-correction + casing + synonym expansion
  embedMs       Int? // embedding the user question
  retrieveMs    Int? // hybridSearch: vector + BM25 + RRF merge
  rerankMs      Int? // cross-encoder rerank (if enabled+en)
  generateMs    Int? // Ollama /api.chat (including stream drain)
  //
  // Hints for analysis — not timing per se, but useful context when reading
  // the breakdown, e.g. "why did retrieveMs jump on this query?"
  contextChunks Int? // how many chunks were actually sent to the LLM
  tokensOut     Int? // answer length (approx tokens = length/4)
  // Null for a normal answer or a low-confidence "No Answer" — those aren't
  // infra failures. Set to 'timeout' or 'error' only when queryKB() threw
  // (Ollama unreachable/timed out) before it could produce either outcome,
  // so the Query Audit Log can tell "we looked and found nothing" apart
  // from "we never got to look."
  errorType     String?
  createdAt     DateTime @default(now())

  // User feedback (thumbs up/down) on this specific answer — see the AI
  // Evaluation system (helpful=false rows can be promoted into the eval
  // dataset for review). Nullable: most rows never receive feedback.
  helpful         Boolean?
  feedbackComment String?   @db.Text
  feedbackAt      DateTime?

  @@index([createdAt])
  @@index([sessionId])
  @@index([helpful])
  @@map("kb_query_logs")
}

// Admin drafts for menu, report, user, and localization edits
model Draft {
  id          Int      @id @default(autoincrement())
  entityType  String   // e.g., "menu", "report", "user", "localization"
  entityId    String   // ID of the entity being edited (or unique key)
  createdBy   String   // admin username
  data        Json     // draft content
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityType, entityId, createdBy])
  @@index([createdAt])
  @@map("drafts")
}

// ---------------------------------------------------------------------------
// RAG Evaluation & Continuous Improvement System
//
// Entirely additive — never read or written by the production query path
// (src/lib/kb.ts's queryKB()). The eval runner calls queryKB() itself (same
// function real users hit) with an optional trace-capture option, then scores
// the result here. See docs/AI_CONFIG.md for the RAG pipeline these tables
// evaluate.
// ---------------------------------------------------------------------------

enum EvalRunStatus {
  pending
  running
  completed
  completed_with_failures
  failed
  cancelled
}

enum EvalResultStatus {
  success
  error
  timeout
}

// Deterministic classification of answerable/unanswerable-question handling —
// see "Abstention / I don't know evaluation" in the eval spec. Computed from
// testCase.answerable x result.noAnswer, not from the judge.
enum EvalAbstentionOutcome {
  correct_abstention   // unanswerable, correctly said no-answer
  incorrect_abstention // answerable, incorrectly said no-answer
  hallucinated_answer  // unanswerable, but an answer was still generated
  correct_answer       // answerable, an answer was generated
  not_applicable       // result errored before either outcome was reached
}

enum EvalSupportStatus {
  supported
  unsupported
  partial
}

// A named, evolving collection of test cases. `version` is a simple counter
// bumped on any test-case add/edit/remove/archive — used purely as a
// human-readable "Dataset: v3" label on runs. Full content snapshotting is
// deliberately NOT done here: reproducibility instead comes from
// EvaluationResult denormalizing question/expectedAnswer at run time, so
// editing a test case later never rewrites a past run's history.
model EvaluationDataset {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  version     Int      @default(1)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testCases EvaluationTestCase[]
  runs      EvaluationRun[]

  @@map("evaluation_datasets")
}

// One golden question. `relevantMenuIds` (page/article-level) is the primary
// retrieval ground truth — kb_chunks.id is an autoincrement that changes on
// every reindex (see KBChunk doc comment above), so a dataset keyed on raw
// chunk ids would silently go stale after the next "Rebuild All." Page-level
// ground truth also matches how citations already work in this system
// (`sources` in KBResult is deduplicated by menuId, never by chunk).
// `relevantChunkIds` is kept as an optional, best-effort finer-grained
// signal — the runner validates each id still exists in kb_chunks at run
// time and excludes/flags stale ones rather than silently miscounting.
model EvaluationTestCase {
  id                Int      @id @default(autoincrement())
  datasetId         Int
  question          String   @db.Text
  expectedAnswer    String?  @db.Text
  relevantMenuIds   String[] @default([])
  relevantChunkIds  Int[]    @default([])
  category          String?
  language          String   @default("en")
  difficulty        String?
  answerable        Boolean  @default(true)
  expectedCitations String[] @default([])
  metadata          Json?
  isActive          Boolean  @default(true)
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dataset EvaluationDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results EvaluationResult[]

  @@index([datasetId])
  @@index([category])
  @@index([language])
  @@map("evaluation_test_cases")
}

// One execution of a dataset against a specific RAG + judge configuration.
// The config/judge fields are a snapshot (not a foreign key to KBConfig,
// which is a mutable singleton) so two runs remain comparable even after
// KBConfig changes later. No separate ModelVersion/PromptVersion tables:
// this app has exactly one "current" RAG config at a time, so an embedded
// snapshot per run is sufficient and comparison is just diffing two rows.
model EvaluationRun {
  id               Int           @id @default(autoincrement())
  name             String
  datasetId        Int
  datasetVersion   Int
  status           EvalRunStatus @default(pending)
  totalCases       Int           @default(0)
  completedCases   Int           @default(0)
  failedCases      Int           @default(0)
  cancelRequested  Boolean       @default(false)
  // Default is 1, not a higher number: on CPU-only Ollama inference (no GPU
  // offload), concurrent generate() calls share the same CPU cores rather
  // than parallelizing real throughput — running 2-3 "concurrently" mostly
  // just context-switches and can make every individual case slower without
  // reducing total wall-clock time. Raise this only once generation is
  // GPU-accelerated (or otherwise fast enough that CPU contention isn't the
  // bottleneck — check the Generate ms column in Failed Questions first).
  concurrency      Int           @default(1)
  maxRetries       Int           @default(1)
  categoryFilter   String[]      @default([])
  testCaseIdFilter Int[]         @default([])

  // RAG config snapshot (mirrors KBConfig's fields at run start)
  embeddingModel   String
  generationModel  String
  chunkSize        Int
  chunkOverlap     Int
  topK             Int
  minScore         Float
  temperature      Float
  rerankerEnabled  Boolean
  rerankerModel    String?
  rerankPoolSize   Int
  rerankMinScore   Float
  systemPromptHash String?

  // Judge config snapshot (mirrors EvalJudgeConfig at run start)
  // judgeEnabled defaults to what EvalJudgeConfig says at run-creation time,
  // but can also be toggled explicitly per-run via the runs/POST body, so
  // admins can do retrieval-only/metrics-only runs without spending LLM
  // judge-calls on every non-abstained answer.
  judgeEnabled     Boolean  @default(true)
  judgeProvider    String
  judgeModel       String
  judgeTemperature Float

  includeDisabledArticles Boolean @default(false)

  createdBy   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  dataset EvaluationDataset  @relation(fields: [datasetId], references: [id])
  results EvaluationResult[]

  @@index([datasetId])
  @@index([status])
  @@map("evaluation_runs")
}

// One test case's outcome within one run. `traceJson` holds the full
// retrieval trace (pool + reranked + final chunks, each with their scores) —
// kept as a single JSON column rather than a normalized "RetrievalResult"
// table since it is always read as one whole trace for failure inspection
// and never aggregated row-by-row (unlike claims/citations below, which are
// real tables because hallucination/citation rates get counted across many
// rows). question/expectedAnswer are denormalized from the test case at run
// time so a later edit to the test case never rewrites this run's history.
model EvaluationResult {
  id                Int                   @id @default(autoincrement())
  runId             Int
  testCaseId        Int
  question          String                @db.Text
  expectedAnswer    String?               @db.Text
  generatedAnswer   String?               @db.Text
  noAnswer          Boolean               @default(false)
  confidence        String?
  sources           Json?
  traceJson         Json?
  retrievalMetrics  Json?
  contextMetrics    Json?
  abstentionOutcome EvalAbstentionOutcome @default(not_applicable)

  rewriteMs   Int?
  normalizeMs Int?
  embedMs     Int?
  retrieveMs  Int?
  rerankMs    Int?
  generateMs  Int?
  totalMs     Int?

  status       EvalResultStatus @default(success)
  errorMessage String?          @db.Text
  createdAt    DateTime         @default(now())

  run              EvaluationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase         EvaluationTestCase @relation(fields: [testCaseId], references: [id])
  judgeEvaluation  JudgeEvaluation?
  humanEvaluations HumanEvaluation[]

  @@unique([runId, testCaseId])
  @@index([runId])
  @@index([testCaseId])
  @@map("evaluation_results")
}

// LLM-as-judge verdict for one EvaluationResult. `rawResponse` is kept in
// full for audit even when parsedOk=false (malformed JSON) — never discarded
// on a parse failure, per the "never crash the run" requirement.
model JudgeEvaluation {
  id       Int @id @default(autoincrement())
  resultId Int @unique

  judgeProvider    String
  judgeModel       String
  judgeTemperature Float
  rawResponse      String  @db.Text
  parsedOk         Boolean @default(true)
  retryCount       Int     @default(0)

  faithfulnessScore         Float?
  supportedClaims           Int?
  unsupportedClaims         Int?
  correctnessScore          Float?
  relevanceScore            Float?
  completenessScore         Float?
  contextRelevanceScore     Float?
  hallucinationDetected     Boolean?
  hallucinationSeverity     String?
  citationCorrectnessScore  Float?
  citationCompletenessScore Float?
  abstentionCorrect         Boolean?
  // Configurable weighted combination of the scores above — always stored
  // alongside every component score, never shown as the only number.
  overallScore              Float?
  weightsJson               Json?
  reasoning                 String? @db.Text

  createdAt DateTime @default(now())

  result    EvaluationResult     @relation(fields: [resultId], references: [id], onDelete: Cascade)
  claims    ClaimEvaluation[]
  citations CitationEvaluation[]

  @@map("evaluation_judge_evaluations")
}

// Per-claim faithfulness breakdown extracted by the judge — never collapse
// this into just the aggregate faithfulnessScore; it's what makes a
// hallucination explainable ("claim X wasn't in the context") rather than a
// single opaque number.
model ClaimEvaluation {
  id                 Int               @id @default(autoincrement())
  judgeEvalId        Int
  order              Int               @default(0)
  claimText          String            @db.Text
  supportStatus      EvalSupportStatus
  supportingChunkRef String?
  confidence         Float?
  severity           String?

  judgeEval JudgeEvaluation @relation(fields: [judgeEvalId], references: [id], onDelete: Cascade)

  @@index([judgeEvalId])
  @@map("evaluation_claim_evaluations")
}

// Per-claim citation check. The judge is given the same `[i]`-numbered
// context block kb.ts already builds for generation (see queryKB's `context`
// variable), so its cited index maps deterministically back to
// chunks[i-1].menuId — checked against the real `sources` array on the
// result. No separate citation format invented for the judge.
model CitationEvaluation {
  id                Int     @id @default(autoincrement())
  judgeEvalId       Int
  order             Int     @default(0)
  claimText         String  @db.Text
  citedSourceRef    String?
  citationExists    Boolean @default(false)
  pointsToRetrieved Boolean @default(false)
  supportsClaim     Boolean @default(false)

  judgeEval JudgeEvaluation @relation(fields: [judgeEvalId], references: [id], onDelete: Cascade)

  @@index([judgeEvalId])
  @@map("evaluation_citation_evaluations")
}

// Human reviewer verdict on an EvaluationResult — many rows allowed per
// result (multiple reviewers). Used both standalone (admin QA) and to
// measure judge-vs-human agreement (meta-evaluation).
model HumanEvaluation {
  id        Int      @id @default(autoincrement())
  resultId  Int
  reviewer  String
  correct   Boolean?
  faithful  Boolean?
  relevant  Boolean?
  complete  Boolean?
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  result EvaluationResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@map("evaluation_human_evaluations")
}

// Singleton config row (id always = 1), same pattern as KBConfig.
//
// timeoutMs/maxTokens defaults were tuned against real measurement on
// CPU-only Ollama inference, not guessed: a plain 72-token production
// answer measured 63,262ms end to end on the dev machine this was built on
// (~880ms/output-token, no GPU offload — see the "Generate" line in the
// KB Query Audit Log). The previous defaults (60_000ms timeout, 1500 max
// tokens) meant a judge call — with a longer prompt and a token budget
// over 20x that single answer — was virtually guaranteed to time out
// before finishing. These numbers are dev-hardware-appropriate; if your
// deployment has GPU-accelerated inference, both can be tightened back
// down safely via Admin -> AI Evaluation -> Settings.
model EvalJudgeConfig {
  id          Int      @id @default(1)
  // Global master-switch for LLM-as-judge scoring. When false, new eval
  // runs skip the judge entirely (judgeProvider/model/temperature snapshots
  // are still recorded, and an explicit per-run `judgeEnabled:true` in the
  // runs/POST body can always override this default).
  enabled     Boolean  @default(true)
  provider    String   @default("ollama")
  model       String   @default("qwen3:8b")
  temperature Float    @default(0.0)
  maxTokens   Int      @default(600)
  timeoutMs   Int      @default(240000)
  retryCount  Int      @default(2)
  weightsJson Json?
  updatedAt   DateTime @updatedAt

  @@map("eval_judge_config")
}

// Singleton quality-gate thresholds (id always = 1), same pattern as
// KBConfig. All nullable — an unset field means that metric isn't gated.
model EvalGateConfig {
  id                   Int      @id @default(1)
  recallAt5Min         Float?
  faithfulnessMin      Float?
  correctnessMin       Float?
  relevanceMin         Float?
  hallucinationRateMax Float?
  p95LatencyMaxMs      Int?
  updatedAt            DateTime @updatedAt

  @@map("eval_gate_config")
}
